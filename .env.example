NODE_ENV=development
PORT=3000

# Usa un valor aleatorio propio de al menos 32 bytes. Los placeholders se
# rechazan al arrancar en producción.
JWT_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=firmas_digitales_v2
# disabled, required, verify-ca o verify-identity.
# En producción el valor por defecto es required; usa verify-ca/verify-identity
# y configura una CA cuando tu proveedor la entregue.
DB_SSL_MODE=disabled
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_CA_BASE64=
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_QUEUE_LIMIT=20
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000

MAX_UPLOAD_SIZE_MB=25
# Suma máxima de todos los archivos de una misma solicitud multipart.
MAX_UPLOAD_TOTAL_SIZE_MB=100

# Protección de CPU y cuota de almacenamiento para llaves RSA-4096.
MAX_KEYS_PER_USER=10
KEY_GENERATION_MAX_REQUESTS=3
KEY_GENERATION_WINDOW_MS=3600000
KEY_GENERATION_CONCURRENCY=2

# Orígenes separados por coma. En desarrollo se permiten los localhost habituales.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opcionales para el primer inicio tras importar firmas_digitales_v2.sql.
# En desarrollo, si se omiten, se generan y muestran una sola vez.
# En producción son obligatorias mientras las cuentas seed sigan deshabilitadas.
INITIAL_ADMIN_PASSWORD=
INITIAL_OWNER_PASSWORD=
